# Copy to .env locally; never commit the real key.
HARNESS_PROVIDER=openai_compatible
# Required: your provider's API base URL, without /chat/completions.
# OpenAI-compatible describes the protocol, not a hard-coded OpenAI host.
HARNESS_BASE_URL=
# Your intended model; use the exact API identifier accepted by your endpoint.
HARNESS_MODEL=Qwen-3.8-flash
HARNESS_API_KEY=
# Tavily Search + Extract; set network_enabled=true in JSON to enable.
# Queries and page URLs are sent to Tavily when enabled; keep the real key local.
TAVILY_API_KEY=
